# Web3Forms — get a free access key at https://web3forms.com/
# This is a public key (safe to expose). It binds form submissions to team@caloundraunited.com.
PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Cloudflare Turnstile site key — optional but recommended for spam protection
# Get one at https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
