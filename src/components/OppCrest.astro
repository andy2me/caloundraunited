---
type Props = {
  hue?: number;
  label?: string;
  logo?: string;
  className?: string;
};

const { hue = 200, label = 'OPP', logo, className = 'crest-mini' } = Astro.props;
const fill = `oklch(0.55 0.14 ${hue})`;
---

{logo ? (
  <img src={logo} alt="" class={className} />
) : (
  <svg viewBox="0 0 24 24" class={className} aria-hidden="true">
    <rect width="24" height="24" fill="#0E0E10" />
    <circle cx="12" cy="12" r="7" fill={fill} />
    <text x="12" y="15" text-anchor="middle"
          font-family="Barlow Condensed, sans-serif"
          font-weight="800" font-size="9" fill="#fff">{label}</text>
  </svg>
)}
