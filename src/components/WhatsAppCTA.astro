---
import { site } from '../data/site';

// Site-wide band promoting the open WhatsApp community. Rendered on every
// page from BaseLayout, just above the footer.
const items = [
  { k: 'Casual kicks', v: 'Small-sided games and fitness sessions, posted as they pop up.' },
  { k: 'Open training', v: `Upcoming sessions — ${site.trainingNight} ${site.trainingTime} at ${site.homeGround}, plus one-offs.` },
  { k: 'Play or support', v: 'Fill-in spots when we\'re short, or just turn up, watch, and have a beer after.' },
  { k: "Men's health", v: 'Blokes moving, talking, and staying connected. That\'s the whole idea.' },
];
---

<section class="wa" data-screen-label="Community">
  <div class="container">
    <div class="wa__panel">
      <div class="wa__copy">
        <div class="wa__eyebrow">
          <span class="wa__glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="presentation" focusable="false">
              <path
                fill="currentColor"
                d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.82c2.16 0 4.19.84 5.72 2.37a8.05 8.05 0 0 1 2.37 5.72c0 4.46-3.63 8.09-8.09 8.09a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.03 8.03 0 0 1-1.23-4.29c0-4.46 3.63-8.09 8.09-8.09Zm-4.5 4.2c-.21 0-.55.08-.84.39-.29.31-1.1 1.08-1.1 2.63 0 1.55 1.13 3.05 1.29 3.26.16.21 2.19 3.34 5.3 4.55.74.29 1.32.46 1.77.59.74.24 1.42.2 1.95.12.6-.09 1.83-.75 2.09-1.47.26-.72.26-1.34.18-1.47-.08-.13-.29-.21-.6-.36-.31-.16-1.83-.9-2.11-1.01-.29-.1-.5-.16-.71.16-.21.31-.81 1.01-.99 1.22-.18.21-.37.24-.68.08-.31-.16-1.31-.48-2.5-1.54-.92-.82-1.55-1.84-1.73-2.15-.18-.31-.02-.48.14-.63.14-.14.31-.37.47-.55.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.55-.08-.16-.7-1.69-.96-2.31-.25-.61-.51-.53-.7-.54-.18-.01-.39-.01-.6-.01Z"
              />
            </svg>
          </span>
          <span>Community · Everyone welcome</span>
        </div>
        <h2 class="wa__title">Join the {site.whatsappCommunity}</h2>
        <p class="wa__lede">
          It's where the team actually lives. Casual kicks and fitness sessions get organised there,
          open training nights get posted there, and so does every chance to pull on a shirt — or to
          just rock up, watch, and have a beer with us afterwards. We're all about men's health:
          moving, laughing, and checking in on each other. Get involved.
        </p>
        <ul class="wa__list">
          {items.map((i) => (
            <li class="wa__item">
              <span class="wa__item-k mono">{i.k}</span>
              <span class="wa__item-v">{i.v}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="wa__action">
        <a
          class="btn wa__btn"
          href={site.whatsappInvite}
          target="_blank"
          rel="noopener noreferrer"
        >
          Join the community <span class="arrow">→</span>
        </a>
        <p class="wa__note mono">
          Free · No trials · No commitment<br />Over 35 or not, players and supporters both
        </p>
      </div>
    </div>
  </div>
</section>
