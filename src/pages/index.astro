---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import MatchReportHero from '../components/MatchReportHero.astro';
import { stats, formLast5, lastFixture, outcome } from '../data/fixtures';
import { ourPosition } from '../data/ladder';
import { squad, teamAverageAge } from '../data/squad';
import { sponsors } from '../data/sponsors';
import { site } from '../data/site';

const posts = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featurePost = posts.find((p) => p.data.feature) ?? posts[0];
const recentPosts = posts
  .filter((p) => p.id !== featurePost?.id)
  .slice(0, 4);

const teaserNames = ['Andy Twomey', 'Jezz Morgan', 'Aaron Bullock', 'Jared Bullock'];
const teaserPlayers = teaserNames
  .map((n) => squad.find((p) => p.name === n && p.group !== 'staff'))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

const last = lastFixture();

// Off-season: the homepage leads with the season wrap-up rather than the
// last scoreline. Flip `site.offSeason` back to false when the new season's
// fixtures land and the score-driven hero returns automatically.
const wrapPost = posts.find((p) => p.id === 'season-wrap-2026');
const seasonPos = ourPosition();
const ord = (n: number): string => {
  if (n % 100 >= 11 && n % 100 <= 13) return `${n}th`;
  return `${n}${['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`;
};

const heroEyebrow = site.offSeason
  ? '2026 season · Wrapped'
  : last
  ? `Latest result · Round ${stats.played.toString().padStart(2, '0')}`
  : 'Latest from the Park';

const goalsLine = `${stats.gf} / ${stats.ga}`;
const formLine = formLast5().join(' ');
const teamAvgAge = teamAverageAge;

const heroMeta = site.offSeason
  ? [
      { k: '2026 finish', v: `${ord(seasonPos)} of 8` },
      { k: 'Record (W–D–L)', v: `${stats.won}–${stats.drawn}–${stats.lost}` },
      { k: 'Goals (F / A)', v: goalsLine },
    ]
  : [
      { k: 'Form (last 5)', v: formLine },
      { k: 'Goals For / Against', v: goalsLine },
      { k: 'Average age', v: String(teamAvgAge) },
    ];

const formatPostDate = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });

// rough days-ago for the hero eyebrow
const daysAgo = (d: Date) => {
  const now = new Date();
  const ms = now.getTime() - d.getTime();
  const days = Math.floor(ms / (1000 * 60 * 60 * 24));
  if (days <= 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 7) return `${days} days ago`;
  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;
  return formatPostDate(d);
};

const lastDateLabel = site.offSeason
  ? 'Building towards 2027'
  : last ? daysAgo(new Date(last.date)) : (featurePost ? daysAgo(featurePost.data.date) : 'this season');

// True when a post should use the dynamic match-report graphic.
// Explicit `image` frontmatter still wins.
const useMatchHero = (p: typeof posts[number]) =>
  !p.data.image && p.data.category === 'Match Report';
// Static poster used behind the homepage hero video. The video iframe
// covers it once it starts playing, so it stays as the bundled image.
const MATCH_REPORT_POSTER = '/assets/news/match-report.webp';

// --- Hero: dynamic latest-match data ----------------------------------------
// Find the news post tied to the most-recent played fixture (if any) and
// extract its YouTube embed ID so we can use the highlights reel as the
// hero background. Falls back to the striped placeholder when no video is
// available.
const latestPost = last?.reportSlug ? posts.find((p) => p.id === last.reportSlug) : undefined;
const ytId = latestPost?.data.videoUrl?.match(/\/embed\/([^?/]+)/)?.[1];
const heroVideoSrc = ytId
  ? `https://www.youtube.com/embed/${ytId}?autoplay=1&mute=1&loop=1&playlist=${ytId}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&disablekb=1`
  : undefined;
const heroPoster = (site.offSeason ? wrapPost?.data.image : latestPost?.data.image) ?? MATCH_REPORT_POSTER;

// Hero copy is fully derived from the latest played fixture + the matching
// news post's optional `heroOpponent` / `heroTagline` / `heroLede` fields.
// Future rounds: just publish the report — no homepage edits needed.
// Off-season: the hero leads with the season wrap-up instead of a scoreline.
const hero = (() => {
  if (site.offSeason) {
    return {
      titleLine1: "That's 2026.",
      titleLine2: 'Wrapped.',
      tagline: 'Same team, fresh strapping.',
      lede: wrapPost?.data.excerpt
        ?? 'Sixth of eight, four wins and a draw, and a group that kept turning up. The full season wrap — and the road to 2027.',
      reportHref: wrapPost ? `/news/${wrapPost.id}` : '/news',
      ctaLabel: 'Read the season wrap',
    };
  }
  if (!last) {
    return { titleLine1: 'Caloundra United.', titleLine2: '', tagline: 'New season.', lede: '', reportHref: '/news', ctaLabel: 'Read the report' };
  }
  const opp = latestPost?.data.heroOpponent ?? last.opponent;
  return {
    titleLine1: `${opp} ${last.result.ga}.`,
    titleLine2: `Us ${last.result.gf}.`,
    tagline: latestPost?.data.heroTagline ?? '',
    lede: latestPost?.data.heroLede ?? latestPost?.data.excerpt ?? '',
    reportHref: latestPost ? `/news/${latestPost.id}` : '/news',
    ctaLabel: 'Read the report',
  };
})();
---

<BaseLayout title="Home" page="home">

  <!-- HERO -->
  <section class="hero" data-screen-label="01 Hero">
    <div class="hero__media">
      {heroPoster && (
        <img
          class="hero__poster"
          src={heroPoster}
          alt=""
          loading="eager"
          decoding="async"
        />
      )}
      {heroVideoSrc && (
        <iframe
          class="hero__video"
          src={heroVideoSrc}
          title="Match highlights"
          loading="lazy"
          frameborder="0"
          allow="autoplay; encrypted-media; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          aria-hidden="true"
          tabindex="-1"
        ></iframe>
      )}
      <div class="hero__scrim" aria-hidden="true"></div>
      {!heroVideoSrc && !heroPoster && (
        <Placeholder
          variant="ph--hero ph--dark"
          corner="[ MATCH PHOTO 16:9 — DROP A HERO IMAGE HERE ]"
          label="teamphoto.jpg · 1920×1080"
        />
      )}
    </div>
    <div class="container">
      <div class="hero__inner">
        <div class="hero__copy">
          <div class="hero__eyebrow">
            <span class="dot"></span>
            <span>{heroEyebrow}</span>
            <span class="hero__eyebrow-date">
              <span style="opacity:.5;" aria-hidden="true">·</span>
              <span>{lastDateLabel}</span>
            </span>
          </div>
          <h1 class="hero__title">
            <span class="hero__line">{hero.titleLine1}</span>
            <span class="hero__line">{hero.titleLine2}</span>
            {hero.tagline && <em class="hero__line">{hero.tagline}</em>}
          </h1>
          <p class="hero__lede">{hero.lede}</p>
          <div class="hero__cta">
            <a class="btn btn--primary" href={hero.reportHref}>{hero.ctaLabel} <span class="arrow">→</span></a>
            {site.offSeason
              ? <a class="btn btn--ghost" href="/contact">Play in 2027</a>
              : <a class="btn btn--ghost" href="/fixtures">Full fixtures</a>}
          </div>
        </div>
        <div class="hero__meta">
          {heroMeta.map((m) => (
            <div class="hero__metaItem">
              <span class="k">{m.k}</span>
              <span class="v mono">{m.v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST NEWS -->
  <section class="section section--paper" data-screen-label="02 Latest news">
    <div class="container">
      <header class="section__head">
        <div>
          <span class="section__eyebrow">Newsroom · Updated weekly</span>
          <h2 class="section__title">Latest from the Park</h2>
        </div>
        <a class="section__more" href="/news">All news →</a>
      </header>

      {featurePost && (
        <article class="feature">
          {useMatchHero(featurePost) ? (
            <MatchReportHero reportSlug={featurePost.id} variant="feature" />
          ) : (
            <Placeholder
              corner="[ FEATURE 16:10 ]"
              label={featurePost.data.heroLabel}
              image={featurePost.data.image}
              alt={featurePost.data.title}
              objectPosition="center center"
            />
          )}
          <div class="feature__body">
            <div class="card__cat">{featurePost.data.category} · {formatPostDate(featurePost.data.date)}</div>
            <h3 class="feature__title">{featurePost.data.title}</h3>
            <p style="color:var(--muted); margin: 0 0 22px; font-size:15px; line-height:1.6;">
              {featurePost.data.excerpt}
            </p>
            <div style="display:flex; gap:14px; align-items:center;">
              <a class="btn btn--ghost-ink" href={`/news/${featurePost.id}`}>Read more <span class="arrow">→</span></a>
              <span class="mono" style="font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted);">{featurePost.data.readTime}</span>
            </div>
          </div>
        </article>
      )}

      <div class="cards">
        {recentPosts.map((p) => (
          <article class="card">
            <a href={`/news/${p.id}`} style="color:inherit; text-decoration:none; display:block;">
              {useMatchHero(p) ? (
                <MatchReportHero reportSlug={p.id} variant="card" />
              ) : (
                <Placeholder
                  corner="[ 4:3 ]"
                  label={p.data.heroLabel}
                  image={p.data.image}
                  alt={p.data.title}
                  objectPosition="center center"
                />
              )}
              <div class="card__body">
                <div class="card__cat">{p.data.category} · {p.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' })}</div>
                <h3 class="card__title">{p.data.title}</h3>
                <p class="card__excerpt">{p.data.excerpt}</p>
                <div class="card__meta"><span>{p.data.readTime}</span><span class="arrow">→</span></div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SQUAD TEASER + JOIN CTA -->
  <section class="section section--dark" data-screen-label="03 Squad teaser">
    <div class="container">
      <header class="section__head">
        <div>
          <span class="section__eyebrow" style="color:#fff;">Meet the eleven (and the bench)</span>
          <h2 class="section__title">The Squad — Sort Of</h2>
        </div>
        <a class="section__more" href="/squad">All players →</a>
      </header>

      <div class="home-squad-teaser">
        {teaserPlayers.map((p) => (
          <article class="player" style="background:transparent; border-color: rgba(255,255,255,0.18);">
            <div class="ph ph--dark">
              {p.image && <img class="ph__img" src={`/assets/players/${p.image}`} alt={p.name} loading="lazy" />}
              {p.num !== undefined && <span class="player__num">{p.num}</span>}
              <span class="player__pos" style="background:rgba(0,0,0,0.55); color:#fff; border-color:rgba(255,255,255,0.2);">
                {p.isCaptain ? 'CAPT' : p.position.replace(' · CAPT', '')}
              </span>
              {!p.image && p.imageLabel && <span class="ph__label">{p.imageLabel}</span>}
            </div>
            <div class="player__body">
              <div class="player__name" style="color:#fff;">{p.name}</div>
              <div class="player__nick" style="color:rgba(255,255,255,0.6);">{p.nick}{p.num !== undefined && ` · #${p.num}`}</div>
              <div class="player__stat" style="color:rgba(255,255,255,0.78); border-top-color:rgba(255,255,255,0.18);" set:html={p.stat} />
            </div>
          </article>
        ))}
      </div>

      <div class="home-recruit-cta">
        <div>
          <h3 style="font-size:clamp(28px,3.2vw,40px); margin:0 0 8px;">Over 35? Quietly furious about it? <em style="color:var(--red); font-style:normal;">We're recruiting.</em></h3>
          <p style="color:rgba(255,255,255,0.7); margin:0; max-width:60ch;">No trials. No politics. Bring boots, shin pads, and a willingness to do the warm-up properly this time.</p>
        </div>
        <a class="btn btn--primary" href="/contact">Get in touch <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- SPONSORS -->
  <section class="sponsors" data-screen-label="04 Partners">
    <div class="container">
      <div class="sponsors__head">
        <span class="sponsors__eyebrow mono">/ Proudly partnered with</span>
        <span class="sponsors__rule" aria-hidden="true"></span>
        <a class="sponsors__more" href="/contact">Become a sponsor →</a>
      </div>
      <div class="sponsors__row">
        {sponsors.map((s) => (
          <a class="sponsors__logo" href={s.href ?? '#'} aria-label={s.ariaLabel ?? s.name}>
            <img src={s.logo} alt={s.name} style={s.imgStyle} />
            <span class="sponsors__tier mono">{s.tier}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
