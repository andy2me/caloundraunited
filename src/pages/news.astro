---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

const posts = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featurePost = posts.find((p) => p.data.feature) ?? posts[0];
const restPosts = posts.filter((p) => p.id !== featurePost?.id);

const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
const fmtShort = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });

// Default hero image for match reports; per-post `image` frontmatter still wins.
const MATCH_REPORT_HERO = '/assets/news/match-report.png';
const heroFor = (p: typeof posts[number]) =>
  p.data.image ?? (p.data.category === 'Match Report' ? MATCH_REPORT_HERO : undefined);
---

<BaseLayout title="News" page="news">

  <header class="pagehead" data-screen-label="01 Page header">
    <div class="container">
      <div class="pagehead__inner">
        <div class="pagehead__eyebrow">Match reports · Training · Off-pitch</div>
        <h1 class="pagehead__title">News</h1>
        <p class="pagehead__lede">Match reports written by people who were definitely there. Training updates filtered through hindsight. The occasional pub review.</p>
      </div>
    </div>
  </header>

  <section class="section section--paper" data-screen-label="02 Filter row">
    <div class="container">
      <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:36px;">
        <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px; background:var(--ink); color:#fff; border-color:var(--ink);">All</button>
        <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px;">Match reports</button>
        <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px;">Training</button>
        <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px;">Club</button>
        <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px;">Off-pitch</button>
        <span style="margin-left:auto;" class="mono"><a href="#" style="font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink); border-bottom:2px solid var(--red); padding-bottom:2px;">RSS feed</a></span>
      </div>

      {featurePost && (
        <article class="feature" style="margin-bottom:48px;">
          <Placeholder
            corner="[ FEATURE 16:10 ]"
            label={featurePost.data.heroLabel}
            image={heroFor(featurePost)}
            alt={featurePost.data.title}
            objectPosition="center center"
          />
          <div class="feature__body">
            <div class="card__cat">{featurePost.data.category} · {fmt(featurePost.data.date)}</div>
            <h3 class="feature__title">{featurePost.data.title}</h3>
            <p style="color:var(--muted); margin: 0 0 22px; font-size:15px; line-height:1.6;">
              {featurePost.data.excerpt}
            </p>
            <div style="display:flex; gap:14px; align-items:center;">
              <a class="btn btn--ghost-ink" href={`/news/${featurePost.id}`}>Read more <span class="arrow">→</span></a>
              <span class="mono" style="font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted);">{featurePost.data.readTime} · {featurePost.data.author}</span>
            </div>
          </div>
        </article>
      )}

      <div class="cards cards--3">
        {restPosts.map((p) => (
          <article class="card">
            <a href={`/news/${p.id}`} style="color:inherit; text-decoration:none; display:block;">
              <Placeholder
                corner="[ 4:3 ]"
                label={p.data.heroLabel}
                image={heroFor(p)}
                alt={p.data.title}
                objectPosition="center center"
              />
              <div class="card__body">
                <div class="card__cat">{p.data.category} · {fmtShort(p.data.date)}</div>
                <h3 class="card__title">{p.data.title}</h3>
                <p class="card__excerpt">{p.data.excerpt}</p>
                <div class="card__meta"><span>{p.data.readTime} · {p.data.author}</span><span class="arrow">→</span></div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:48px; padding-top:24px; border-top:1px solid var(--hairline);">
        <span class="mono" style="font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted);">Showing {posts.length} of {posts.length} stor{posts.length === 1 ? 'y' : 'ies'}</span>
        <div style="display:flex; gap:8px;">
          <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px; opacity:.4;" disabled>← Newer</button>
          <button class="btn btn--ghost-ink" style="padding:10px 16px; font-size:12px; opacity:.4;" disabled>Older →</button>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
